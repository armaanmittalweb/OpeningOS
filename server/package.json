{
  "name": "openingos-backend",
  "version": "1.0.0-saas-complete",
  "private": true,
  "type": "module",
  "description": "Production SaaS backend for OpeningOS accounts, auth recovery, passkeys, graph sync, coach workspaces, sharing, imports, analysis, billing, audit and admin.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate:print": "cat migrations/001_init.sql && cat migrations/002_saas_complete.sql",
    "migrate": "psql \"$DATABASE_URL\" -f migrations/001_init.sql && psql \"$DATABASE_URL\" -f migrations/002_saas_complete.sql"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8",
    "@fastify/cookie": "^9.4.0",
    "stripe": "^16.2.0",
    "nodemailer": "^6.9.14",
    "@simplewebauthn/server": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "@types/pg": "^8.11.6",
    "@types/nodemailer": "^6.4.15"
  }
}
