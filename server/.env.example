# OpeningOS backend environment
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openingos
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:4173
CORS_ORIGIN=http://localhost:4173
ACCESS_TTL_SECONDS=1800
REFRESH_TTL_DAYS=30
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW=1 minute
IMPORT_RATE_LIMIT_MAX=18
IMPORT_RATE_LIMIT_WINDOW=15 minutes

# Optional OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LICHESS_CLIENT_ID=
LICHESS_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8787/auth/oauth/callback

# Optional billing
STRIPE_CHECKOUT_URL=
STRIPE_PORTAL_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpeningOS <no-reply@openingos.local>

# Optional engine analysis
STOCKFISH_PATH=
