{
  "name": "openingos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first chess opening repertoire trainer.",
  "scripts": {
    "postinstall": "node scripts/copy-stockfish.mjs",
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@scure/bip39": "^2.4.0",
    "chess.js": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
